DB_HOST=127.0.0.1
DB_USERNAME=admin
DB_PASSWORD=password
DB_NAME=sample
DB_PORT=5432
# Optional Google sign-in (secures an account). Without FIREBASE_PROJECT_ID players can still
# play on a username alone. Locally the emulator stands in for Google: docker compose --profile auth up
FIREBASE_PROJECT_ID=demo-lemonade
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
