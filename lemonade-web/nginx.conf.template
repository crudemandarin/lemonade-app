server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Filled in by the nginx image's envsubst at startup (see Dockerfile).
    # Docker Compose: http://api:8080 via Docker's embedded DNS.
    # Elsewhere: any http(s) API URL plus a resolver that can look it up.
    # Resolving at request time lets nginx start even if the api is down.
    resolver ${NGINX_RESOLVER} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    # Proxy API calls to the backend unchanged: the API serves its routes under /api.
    # (proxy_pass with a variable and no URI part forwards the original request URI.)
    location /api/ {
        proxy_pass $api_upstream;
        # Send the upstream's own host (and TLS SNI), which hosted platforms route on.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Firebase web settings, rendered per deployment from environment variables, so one
    # image serves any GCP project. Never cached (a redeploy to another project must not
    # see the old one), and kept out of the service worker's asset groups. authDomain is
    # this host: /__/auth/ below is proxied to Firebase, which keeps the redirect
    # sign-in same-origin (browsers block the third-party storage it would need otherwise).
    location = /config/firebase-config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"apiKey":"${FIREBASE_API_KEY}","authDomain":"$http_host","projectId":"${FIREBASE_PROJECT_ID}","appId":"${FIREBASE_APP_ID}","useEmulator":${FIREBASE_USE_EMULATOR},"emulatorUrl":"${FIREBASE_EMULATOR_URL}"}';
    }

    # Firebase's sign-in helper pages and scripts, served from this origin.
    # Do not add Cross-Origin-Opener-Policy: same-origin anywhere: it breaks popup sign-in.
    location /__/ {
        set $firebase_upstream https://${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_pass $firebase_upstream;
        proxy_set_header Host ${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_ssl_server_name on;
    }

    # nginx's default mime types don't include the web app manifest.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: let the Angular router handle unknown paths. no-cache means
    # "revalidate before reuse" (cheap 304s), so index.html, ngsw.json and the
    # service worker script are never served stale; that is how PWA updates arrive.
    # The built JS and CSS are content-hashed, so a revalidation costs almost nothing.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
